help_heading: None
conflicts: ["first", "last", "from", "to"]
set: []
help: Some("Select turns by number: a single turn (`3`), an inclusive range (`1..5`), or an open range like `10..` (turn 10 onward), `..10` (the first 10), or `..` (all). Numbers are 1-based and stable across new turns; `-N` instead counts from the end, so `-1` is the last turn and `-3..-2` the two turns before it")
long_help: None

### from
short: None
long: Some("from")
visible_aliases: []
hidden_aliases: []
short_aliases: None
index: None
action: Set
num_args: Some(1)
value_type: jp_cli::cmd::turn_selection::CliRangeBound
possible_values: []
value_names: Some(["FROM"])
value_delimiter: None
default_values: []
help_heading: None
conflicts: []
set: []
help: Some("Start of the range, inclusive")
long_help: Some("Start of the range, inclusive.\n\nAccepts a 1-based turn number (`3`), a from-end offset (`-1` is the last turn), a relative duration (`5h`), a date (`2026-01-01`), an RFC 3339 timestamp, or `last-compaction` (the turn after the most recent compaction).\n\nA time-based value starts the selection at the first turn to *begin* after the given instant, so the turn that was already running at that instant is excluded. A bound never splits a turn.")

### to
short: None
long: Some("to")
visible_aliases: []
hidden_aliases: []
short_aliases: None
index: None
action: Set
num_args: Some(1)
value_type: jp_cli::cmd::turn_selection::CliRangeBound
possible_values: []
value_names: Some(["TO"])
value_delimiter: None
default_values: []
help_heading: None
conflicts: []
set: []
help: Some("End of the range, inclusive")
long_help: Some("End of the range, inclusive.\n\nAccepts the same forms as `--from`, except `last-compaction`, which only makes sense as a start bound.\n\nA time-based value ends the selection at (and includes) the turn that was running at the given instant — the mirror of `--from`, which excludes it. A bound never splits a turn.")

### keep_first
short: None
long: Some("keep-first")
visible_aliases: []
hidden_aliases: []
short_aliases: None
index: None
action: Set
num_args: Some(1)
value_type: jp_config::conversation::compaction::RuleBound
possible_values: []
value_names: Some(["KEEP_FIRST"])
value_delimiter: None
default_values: []
help_heading: None
conflicts: []
set: []
help: Some("Protect the first N turns from the selection")
long_help: Some("Protect the first N turns from the selection.\n\nAccepts a turn count (`2`), an absolute 1-based turn (`@3`), a from-end offset (`-3`), a duration (`5h`), or `last-compaction` (protect every turn through the most recent compaction). Composes with every other selector: the selection starts no earlier than the first unprotected turn.")

