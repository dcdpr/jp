      "tool_call": {
        "show": true,
        "progress": {
          "show": true,
          "delay_secs": 3,
          "interval_ms": 100
        },
        "preparing": {
          "show": true,
          "delay_secs": 3,
          "interval_ms": 100
        }
      },
      "typewriter": {
        "text_delay": "3ms",
        "code_delay": "500us",
        "max_latency": "0s"
      }
