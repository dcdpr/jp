#!/usr/bin/env bash
#
# Pass when the iteration left one commit that changes the prose of the target
# RFD and nothing else:
#
# - exactly one commit, touching only the target file, with a `docs(rfd): `
#   subject, and nothing left uncommitted;
# - the title line and metadata header byte-identical;
# - every fenced code block byte-identical;
# - no new or changed link reference definitions;
# - no link to one of the RFD's headings broken by a renamed heading;
# - `comfort --check` clean.
#
# A turn that ran out of output tokens before committing counts as a failed
# attempt, not as an RFD that needed no changes.
#
# Records the outcome in `state/progress.tsv`, and the reason for a failure in
# `state/gate-reason`, which the next prompt for the same RFD includes.

set -euo pipefail

MAX_ATTEMPTS=3

cd "$LOOP_ROOT"
state_rel=${LOOP_STATE#"$LOOP_ROOT"/}
progress=$LOOP_STATE/progress.tsv
reason_file=$LOOP_STATE/gate-reason
base=$LOOP_ITERATION_BASE
target=$(cat "$LOOP_STATE/current")
name=$(basename "$target")
id=${name%%-*}

record() {
    printf '%s\t%s\t%s\n' "$id" "$1" "$2" >> "$progress"
}

fail() {
    echo "FAIL: $1"
    {
        printf '%s\n' "$id"
        printf '%s\n' "$1" | head -n 40
    } > "$reason_file"

    # A turn cut short by a usage limit or a network stall has not attempted the
    # RFD. A turn that ran into the per-turn timeout (124) has.
    if [[ $LOOP_TURN_STATUS -eq 0 || $LOOP_TURN_STATUS -eq 124 ]]; then
        record attempt "$(printf '%s' "$1" | head -n 1)"
        local attempts
        attempts=$(awk -F'\t' -v id="$id" '$1 == id && $2 == "attempt"' "$progress" | wc -l | tr -d ' ')
        if [[ $attempts -ge $MAX_ATTEMPTS ]]; then
            record gave-up "$attempts failed attempts"
            echo "giving up on $id after $attempts attempts"
        fi
    fi
    exit 1
}

# The parts of an RFD a prose pass must leave alone: the title and metadata
# header, and the fenced code blocks.
skeleton() {
    awk '
        !body && /^- \*\*/ { meta = 1 }
        !body && (/^## / || (meta && /^$/)) { body = 1 }
        !body { print "header: " $0; next }
        /^ *(```|~~~)/ { fence = !fence; print "fence: " $0; next }
        fence { print "code: " $0; next }
    '
}

link_definitions() {
    awk '
        /^ *(```|~~~)/ { fence = !fence; next }
        !fence && /^\[[^]]+\]:[ \t]/ { print }
    ' | sort -u
}

commits=$(git rev-list --count "$base..HEAD")
dirty=$(git status --porcelain -- . ":(exclude)$state_rel")

# `jp` exits 0 when a response stops at the output token limit, so the turn's
# exit status alone reads like a turn that chose to change nothing. Only the
# tail is searched: earlier output can quote the message from JP's sources.
turn_log=$LOOP_RUN_DIR/iter-$LOOP_ITERATION.log
turn_tail=""
if [[ -f $turn_log ]]; then
    turn_tail=$(tail -n 40 "$turn_log")
fi
if [[ $commits -eq 0 && $turn_tail == *"reached the model's max output tokens"* ]]; then
    fail "the turn ran out of output tokens before the RFD was committed; reasoning counts toward the limit. Work one section at a time: apply each section's changes with \`fs_modify_file\` before reasoning about the next, instead of planning the whole RFD first."
fi

if [[ $commits -eq 0 && -z $dirty ]]; then
    if [[ $LOOP_TURN_STATUS -eq 0 ]]; then
        record unchanged "-"
        rm -f "$reason_file"
        echo "PASS: $id needed no changes"
    else
        echo "SKIP: the turn exited $LOOP_TURN_STATUS without changing anything; $id is retried"
    fi
    exit 0
fi

if [[ -n $dirty ]]; then
    fail "uncommitted changes were left in the tree:
$dirty"
fi
if [[ $commits -ne 1 ]]; then
    fail "expected exactly one commit, found $commits"
fi

changed=$(git diff --name-only "$base" HEAD)
if [[ $changed != "$target" ]]; then
    fail "the commit must change only $target, but it changed:
$changed"
fi

subject=$(git log -1 --format=%s)
if [[ $subject != "docs(rfd): "* ]]; then
    fail "the commit subject must start with \`docs(rfd): \`, but it is: $subject"
fi

skeleton_diff=$(diff <(git show "$base:$target" | skeleton) <(git show "HEAD:$target" | skeleton) || true)
if [[ -n $skeleton_diff ]]; then
    fail "the title, metadata, or code blocks changed:
$skeleton_diff"
fi

new_links=$(comm -13 <(git show "$base:$target" | link_definitions) <(git show "HEAD:$target" | link_definitions))
if [[ -n $new_links ]]; then
    fail "link reference definitions were added or changed:
$new_links"
fi

set +e
anchor_report=$(node "$LOOP_MISSION_DIR/check-anchors.mjs" "$base" HEAD "$target" 2>&1)
anchor_rc=$?
set -e
if [[ $anchor_rc -eq 1 ]]; then
    fail "the change left \`#\` links that name no heading. Point each at the anchor shown; the site lowercases a heading and turns punctuation, including \`_\`, \`.\`, and backticks, into \`-\`. Don't change a link's anchor unless you renamed its heading:
$anchor_report"
elif [[ $anchor_rc -ne 0 ]]; then
    fail "the anchor check could not run (exit $anchor_rc):
$anchor_report"
fi

if ! format=$(comfort --check --language markdown "$target" 2>&1); then
    fail "\`comfort --check\` reports formatting drift; run \`markdown_format\` on $target:
$format"
fi

record done "$(git log -1 --format='%h %s')"
rm -f "$reason_file"
echo "PASS: $id"
